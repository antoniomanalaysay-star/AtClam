# PostgreSQL connection (the app stores all data here)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AtClam
DB_USER=postgres
DB_PASSWORD=root

# Optional. If omitted, a secret is generated once in backend/data/.jwt_secret
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_HOURS=168

# Where the server listens (uvicorn also accepts these on the command line)
HOST=0.0.0.0
PORT=8000
